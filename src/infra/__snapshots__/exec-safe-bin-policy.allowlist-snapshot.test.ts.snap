// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`exec-safe-bin policy allowlist snapshot > locks DEFAULT_SAFE_BINS — owner approval required to change > default-safe-bins 1`] = `
[
  "cut",
  "head",
  "tail",
  "tr",
  "uniq",
  "wc",
]
`;

